<Window x:Class="EmailAnalyser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sähköpostiavustaja" Height="820" Width="1450" MinWidth="900" MinHeight="500">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding AcceptAiCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Näytä:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="190" ItemsSource="{Binding FilterOptions}" DisplayMemberPath="Text" SelectedValuePath="Key"
                          SelectedValue="{Binding Filter}" />
                <TextBlock Text="Laatikko:" VerticalAlignment="Center" Margin="16,0,6,0" />
                <ComboBox Width="240" ItemsSource="{Binding Mailboxes}" SelectedItem="{Binding Mailbox}" />
                <CheckBox Content="Sokkomerkintä (piilota AI-arvio, kunnes merkitty)" IsChecked="{Binding BlindMode}"
                          VerticalAlignment="Center" Margin="16,0,0,0" />
                <Button Content="Päivitä (F5)" Command="{Binding RefreshCommand}" Margin="16,0,0,0" Padding="10,2" />
                <TextBlock Text="{Binding NewResultsHint}" Foreground="#0B5CAD" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                <Button Content="Käsittele nyt" Command="{Binding ProcessNowCommand}" Margin="24,0,0,0" Padding="10,2"
                        ToolTip="Hae uudet viestit ja käsittele jono heti, jos näytönohjain on vapaa" />
                <Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}" Margin="6,0,0,0" Padding="10,2"
                        ToolTip="Keskeyttää haun ja eräajon; käynnissä oleva erä pysäytetään ja malli puretaan" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="8,3" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F7F7F7" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MonitorAttention}" Value="True">
                            <Setter Property="Background" Value="#FFF4E5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMonitor}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMonitor}" />
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusQueue}" />
            <Separator />
            <StatusBarItem Content="{Binding StatusBatch}" />
            <Separator />
            <StatusBarItem Content="{Binding StatusLabels}" />
            <Separator />
            <StatusBarItem Content="{Binding StatusProblems}" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="✓" Binding="{Binding LabeledMark}" Width="26" />
                    <DataGridTextColumn Header="Laatikko" Binding="{Binding Mailbox}" Width="150" />
                    <DataGridTextColumn Header="Saapunut" Binding="{Binding Received}" SortMemberPath="ReceivedSort" Width="115" />
                    <DataGridTextColumn Header="Lähettäjä" Binding="{Binding Sender}" Width="150" />
                    <DataGridTextColumn Header="Otsikko" Binding="{Binding Subject}" Width="*" />
                    <DataGridTextColumn Header="Toimenpide" Binding="{Binding AiAction}" Width="90" />
                    <DataGridTextColumn Header="Kiireellisyys" Binding="{Binding AiUrgency}" Width="100" />
                    <DataGridTextColumn Header="Määräaika" Binding="{Binding AiDeadline}" Width="80" />
                    <DataGridTextColumn Header="Tila" Binding="{Binding Status}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E5E5E5" />

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="10">
                <StackPanel DataContext="{Binding Selected}">
                    <TextBlock Text="{Binding Subject}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="{Binding Sender, Mode=OneWay}" /> <Run Text="&lt;" Foreground="Gray" /><Run Text="{Binding SenderAddress, Mode=OneWay}" Foreground="Gray" /><Run Text="&gt;" Foreground="Gray" />
                    </TextBlock>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap">
                        <Run Text="{Binding Mailbox, Mode=OneWay}" /> · <Run Text="{Binding Received, Mode=OneWay}" /> · <Run Text="{Binding Status, Mode=OneWay}" />
                    </TextBlock>
                    <Button Content="Avaa Outlookissa (Ctrl+O)" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,2"
                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <GroupBox Header="AI-arvio" Margin="0,12,0,0" Padding="6"
                              Visibility="{Binding ShowAi, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Border Background="#FFF4E5" BorderBrush="#F0B35B" BorderThickness="1" Padding="6" Margin="0,0,0,8"
                                    Visibility="{Binding InjectionSuspected, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Viestissä on tekoälylle osoitettua tekstiä. Arvio voi olla viestin ohjailema: tarkista viesti itse." />
                            </Border>
                            <Border Background="#FDECEC" BorderBrush="#D9534F" BorderThickness="1" Padding="6" Margin="0,0,0,8"
                                    Visibility="{Binding SenderSuspected, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Vastaanottava palvelin ei hyväksynyt lähettäjän tunnistusta, tai näyttönimessä on eri osoite kuin todellisella lähettäjällä. Viesti voi olla huijaus: älä maksa, avaa linkkejä tai anna tunnuksia ennen kuin olet varmistanut lähettäjän muuta kautta." />
                            </Border>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{Binding AiAction, Mode=OneWay}" FontWeight="SemiBold" /> · <Run Text="{Binding AiUrgency, Mode=OneWay}" /> · määräaika <Run Text="{Binding AiDeadline, Mode=OneWay}" /> · <Run Text="{Binding AiTopic, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="Yhteenveto" Foreground="Gray" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                            <TextBlock Text="Perustelu" Foreground="Gray" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Rationale}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Review}" Foreground="#B05000" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Category}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding ModelInfo}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Arvio on paikallisen kielimallin ehdotus. Viestin sisältö voi vaikuttaa siihen, joten tarkista lähettäjä ennen maksuja, tunnusten antamista tai muita toimia." />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Oma merkintä" Margin="0,12,0,0" Padding="6"
                              DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Toimenpide" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2" ItemsSource="{Binding ActionOptions}"
                                      DisplayMemberPath="Text" SelectedValuePath="Key" SelectedValue="{Binding EditAction}" />
                            <TextBlock Grid.Row="1" Text="Kiireellisyys" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" ItemsSource="{Binding UrgencyOptions}"
                                      DisplayMemberPath="Text" SelectedValuePath="Key" SelectedValue="{Binding EditUrgency}" />
                            <TextBlock Grid.Row="2" Text="Aihe" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" ItemsSource="{Binding TopicOptions}"
                                      DisplayMemberPath="Text" SelectedValuePath="Key" SelectedValue="{Binding EditTopic}" />
                            <TextBlock Grid.Row="3" Text="Määräaika" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,2">
                                <Button DockPanel.Dock="Right" Content="Ei määräaikaa" Padding="6,0" Margin="6,0,0,0"
                                        Click="ClearDeadline_Click" />
                                <DatePicker SelectedDate="{Binding EditDeadline}" />
                            </DockPanel>
                            <WrapPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                <Button Content="Tallenna (Ctrl+S)" Command="{Binding SaveCommand}" Padding="10,2" Margin="0,0,6,4" />
                                <Button Content="AI oli oikeassa (Ctrl+Enter)" Command="{Binding AcceptAiCommand}" Padding="10,2" Margin="0,0,6,4" />
                                <Button Content="Poista merkintä" Command="{Binding DeleteLabelCommand}" Padding="10,2" Margin="0,0,6,4" />
                            </WrapPanel>
                            <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding Selected.LabelInfo}" Foreground="Gray" TextWrapping="Wrap" />
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
