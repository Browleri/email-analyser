<Window x:Class="EmailAnalyser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EmailAnalyser.App"
        Title="{Binding WindowTitle}" Icon="Assets/seula.ico" Height="820" Width="1450" MinWidth="900" MinHeight="560"
        Background="{StaticResource BarkWhite}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding AcceptAiCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ToggleDoneCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <DockPanel Background="{StaticResource BarkWhite}">
        <!-- Title band in bark black, with a birch-bark stripe below. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BarkBlack}" Padding="14,9">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="{StaticResource Cloudberry}" CornerRadius="3" Padding="8,2" VerticalAlignment="Center"
                        Visibility="{Binding Masked, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Peitetty näkymä: viestien tekstit on korvattu" Foreground="{StaticResource Ink}" FontSize="12" />
                </Border>
                <!-- Logo A: a round sieve with one cloudberry caught on the mesh (small version without the holes). -->
                <Viewbox Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Canvas Width="64" Height="64">
                        <Ellipse Canvas.Left="7" Canvas.Top="4" Width="50" Height="50" Stroke="{StaticResource BarkWhite}" StrokeThickness="6" />
                        <Ellipse Canvas.Left="31" Canvas.Top="16" Width="14" Height="14" Fill="{StaticResource Cloudberry}" />
                        <Ellipse Canvas.Left="27" Canvas.Top="56" Width="4" Height="4" Fill="{StaticResource LeafBright}" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Seula" Foreground="{StaticResource BarkWhite}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="paikallinen tekoäly: viestit eivät lähde koneelta" Foreground="{StaticResource OnDarkMuted}" FontSize="12"
                           Margin="14,1,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <Rectangle DockPanel.Dock="Top" Height="8" Fill="{StaticResource BirchBark}" />

        <!-- View controls; monitoring controls are on the monitor line at the bottom. -->
        <Border DockPanel.Dock="Top" Padding="12,4,12,6" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,18,3">
                    <TextBlock Text="Näytä" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="230" ItemsSource="{Binding FilterOptions}" DisplayMemberPath="Text" SelectedValuePath="Key"
                              SelectedValue="{Binding Filter}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,18,3">
                    <TextBlock Text="Laatikko" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="240" ItemsSource="{Binding Mailboxes}" SelectedItem="{Binding Mailbox}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding BlindMode}" VerticalAlignment="Center" Margin="0,3,18,3"
                          ToolTip="Piilottaa AI-arvion, kunnes olet merkinnyt viestin, jotta arvio ei ohjaa merkintää. Ohjelman varoitukset näkyvät silti.">
                    <TextBlock Text="Sokkomerkintä" />
                </CheckBox>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                    <Button Content="Päivitä (F5)" Command="{Binding RefreshCommand}" />
                    <TextBlock Text="{Binding NewResultsHint}" Foreground="{StaticResource Lake}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Blind labelling hides the AI's answer, so the attention view would look empty without this. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CloudberryPale}" BorderBrush="{StaticResource Cloudberry}" BorderThickness="4,0,0,1"
                Padding="12,6" Visibility="{Binding BlindMode, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Lopeta sokkomerkintä" Command="{Binding StopBlindCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                    <Run Text="Sokkomerkintä on päällä." FontWeight="SemiBold" />
                    <Run Text="AI-arvio on piilotettu merkitsemättömistä viesteistä, joten toimenpiteet ja &quot;Vaatii huomiota&quot; perustuvat vain omiin merkintöihisi ja ohjelman varoituksiin. Näkymäksi vaihdettiin Merkitsemättömät; lopetus palauttaa edellisen näkymän." />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Live monitoring state and its controls. -->
        <Border DockPanel.Dock="Bottom" Padding="12,5" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Pale}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MonitorAttention}" Value="True">
                            <Setter Property="Background" Value="{StaticResource CloudberryPale}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}" Margin="8,0,0,0" Padding="12,2"
                        ToolTip="Keskeyttää haun ja eräajon; käynnissä oleva erä pysäytetään ja malli puretaan" />
                <Button DockPanel.Dock="Right" Content="Käsittele nyt" Command="{Binding ProcessNowCommand}" Margin="8,0,0,0" Padding="12,2"
                        ToolTip="Hae uudet viestit ja käsittele jono heti, jos näytönohjain on vapaa" />
                <TextBlock Text="{Binding StatusMonitor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMonitor}" />
            </DockPanel>
        </Border>

        <!-- The list as of the last refresh. -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource BarkWhite}" Padding="6,1">
            <StatusBarItem Content="{Binding StatusList}" />
            <Separator Background="{StaticResource Line}" />
            <StatusBarItem Content="{Binding StatusLabels}" />
            <Separator Background="{StaticResource Line}" />
            <StatusBarItem Content="{Binding StatusProblems}" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" MinWidth="460" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="List" Grid.Column="0" Margin="12,12,0,12" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                <DataGrid.Resources>
                    <local:BindingProxy x:Key="Proxy" Data="{Binding}" />
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Emphasis}" Value="danger">
                                <Setter Property="Background" Value="{StaticResource LingonberryPale}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Emphasis}" Value="done">
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="⚠" Width="30" MinWidth="30" SortMemberPath="HasWarning" CanUserResize="False"
                                            HeaderStyle="{StaticResource IconHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WarningMark}" ToolTip="{Binding WarningTip}" Foreground="{StaticResource Lingonberry}"
                                           FontWeight="Bold" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="✓" Width="28" MinWidth="28" SortMemberPath="IsLabeled" CanUserResize="False"
                                            HeaderStyle="{StaticResource IconHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LabeledMark}" Foreground="{StaticResource Leaf}" FontWeight="Bold" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Laatikko" Binding="{Binding Mailbox}" Width="110"
                                        Visibility="{Binding Data.ShowMailboxColumn, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}" />
                    <DataGridTextColumn Header="Saapunut" Binding="{Binding Received}" SortMemberPath="ReceivedSort" Width="92" MinWidth="88" />
                    <DataGridTextColumn Header="Lähettäjä" Binding="{Binding Sender}" Width="135" MinWidth="90" />
                    <DataGridTextColumn Header="Otsikko" Binding="{Binding Subject}" Width="*" MinWidth="140" />
                    <DataGridTemplateColumn Header="Arvio" SortMemberPath="PrioritySort" Width="180" MinWidth="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource ActionTag}" Tag="{Binding ActionKey}" ToolTip="{Binding ActionSource}">
                                        <TextBlock Text="{Binding ActionText}" />
                                    </Border>
                                    <TextBlock Text="{Binding UrgencyText}" Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UrgencyKey}" Value="tanaan">
                                                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding StateText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Määräaika" Binding="{Binding EffectiveDeadline}" SortMemberPath="DeadlineSort" Width="88"
                                        Visibility="{Binding Data.ShowDeadlineColumn, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" />

            <Grid Grid.Column="2" Margin="0,12,12,12">
                <TextBlock Text="Valitse viesti listasta." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding NoSelection, Converter={StaticResource BoolToVisibility}}" />

                <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <!-- Labelling form pinned to the bottom, so it never scrolls away. -->
                    <GroupBox DockPanel.Dock="Bottom" Header="Oma merkintä" Margin="0,10,0,0" Padding="12,4,12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Toimenpide" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2" ItemsSource="{Binding ActionOptions}"
                                      DisplayMemberPath="Text" SelectedValuePath="Key" SelectedValue="{Binding EditAction}" />
                            <TextBlock Grid.Row="1" Text="Kiireellisyys" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" ItemsSource="{Binding UrgencyOptions}"
                                      DisplayMemberPath="Text" SelectedValuePath="Key" SelectedValue="{Binding EditUrgency}" />
                            <TextBlock Grid.Row="2" Text="Aihe" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" ItemsSource="{Binding TopicOptions}"
                                      DisplayMemberPath="Text" SelectedValuePath="Key" SelectedValue="{Binding EditTopic}" />
                            <TextBlock Grid.Row="3" Text="Määräaika" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,2">
                                <Button DockPanel.Dock="Right" Content="Tyhjennä" Padding="8,2" Margin="6,0,0,0" Click="ClearDeadline_Click"
                                        ToolTip="Poistaa määräajan" />
                                <DatePicker SelectedDate="{Binding EditDeadline}" Loaded="DeadlinePicker_Loaded" />
                            </DockPanel>
                            <TextBlock Grid.Row="4" Text="Perustelu" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" Padding="4,3" MaxLength="{Binding NoteMaxLength, Mode=OneTime}"
                                     Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Valinnainen: muutama sana siitä, miksi merkitsit näin. Tallentuu salattuun tietokantaan ja vientitiedostoon." />
                            <WrapPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                <Button Content="Tallenna" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6"
                                        ToolTip="Tallenna merkintä ja siirry seuraavaan (Ctrl+S)" />
                                <Button Content="AI oli oikeassa" Command="{Binding AcceptAiCommand}" Margin="0,0,6,6"
                                        ToolTip="Tallenna AI-arvio merkinnäksi ja siirry seuraavaan (Ctrl+Enter)" />
                                <Button Content="Poista" Command="{Binding DeleteLabelCommand}" Margin="0,0,6,6" ToolTip="Poista oma merkintä" />
                            </WrapPanel>
                            <StackPanel Grid.Row="6" Grid.ColumnSpan="2">
                                <TextBlock Text="Muutoksia ei ole tallennettu (Ctrl+S)" Foreground="#8A5300" FontWeight="SemiBold" FontSize="12"
                                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Selected.LabelInfo}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding Selected}" Margin="0,0,4,0">
                            <TextBlock Text="{Binding Subject}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                <Run Text="{Binding Sender, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="{Binding SenderAddressText, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap">
                                <Run Text="{Binding Mailbox, Mode=OneWay}" /> · <Run Text="{Binding ReceivedLong, Mode=OneWay}" />
                            </TextBlock>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Avaa Outlookissa (Ctrl+O)" Margin="0,0,6,6"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Button Content="{Binding DataContext.DoneButtonText, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,6,6"
                                        Command="{Binding DataContext.ToggleDoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Kuittaa viestin hoidetuksi tässä sovelluksessa. Outlookiin ei kirjoiteta mitään, ja merkintä ja arvio säilyvät." />
                            </WrapPanel>
                            <TextBlock Text="{Binding DoneInfo}" Foreground="{StaticResource Leaf}" FontSize="12" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- The program's own warnings: outside the AI card so that blind mode does not hide them. -->
                            <Border Background="{StaticResource LingonberryPale}" BorderBrush="{StaticResource Lingonberry}" BorderThickness="4,0,0,0"
                                    Padding="12,8" Margin="0,12,0,0"
                                    Visibility="{Binding SenderSuspected, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Mahdollinen huijaus" FontWeight="SemiBold" Foreground="{StaticResource Lingonberry}" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="Vastaanottava palvelin ei hyväksynyt lähettäjän tunnistusta, tai näyttönimessä on eri osoite kuin todellisella lähettäjällä. Älä maksa, avaa linkkejä tai anna tunnuksia ennen kuin olet varmistanut lähettäjän muuta kautta." />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource CloudberryPale}" BorderBrush="{StaticResource Cloudberry}" BorderThickness="4,0,0,0"
                                    Padding="12,8" Margin="0,12,0,0"
                                    Visibility="{Binding InjectionSuspected, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Viesti yrittää ohjailla tekoälyä" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="Viestissä on tekoälylle osoitettua tekstiä, joten AI-arvio voi olla viestin ohjailema. Tarkista viesti itse." />
                                    <Button Content="Näytä ohjailukohta" HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Command="{Binding DataContext.ShowInjectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="Lukee viestin Outlookista ja näyttää kohdan, johon ohjelman tarkistus osui. Kohtaa ei tallenneta." />
                                    <TextBlock Text="{Binding DataContext.ExcerptInfo, RelativeSource={RelativeSource AncestorType=Window}}"
                                               TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" />
                                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Cloudberry}" BorderThickness="1"
                                            Padding="8,6" Margin="0,6,0,0"
                                            Visibility="{Binding DataContext.HasExcerpt, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                                   DataContext="{Binding DataContext.Excerpt, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Run Text="{Binding Before, Mode=OneWay}" Foreground="{StaticResource Muted}" /><Run Text="{Binding Hit, Mode=OneWay}" FontWeight="Bold" Background="{StaticResource Cloudberry}" /><Run Text="{Binding After, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="AI-arvio on piilotettu, kunnes olet merkinnyt viestin (sokkomerkintä)." Foreground="{StaticResource Muted}"
                                       FontStyle="Italic" TextWrapping="Wrap" Margin="0,14,0,0"
                                       Visibility="{Binding AiHidden, Converter={StaticResource BoolToVisibility}}" />
                            <GroupBox Header="AI-arvio" Margin="0,12,0,0"
                                      Visibility="{Binding ShowAi, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <!-- One line: the same facts as the list row, so the card leaves room for the text. -->
                                    <WrapPanel Margin="0,6,0,0">
                                        <Border Style="{StaticResource ActionTag}" Tag="{Binding AiActionKey}" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding AiActionText}" />
                                        </Border>
                                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                            <Run Text="{Binding AiUrgency, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " Foreground="{StaticResource Muted}" /><Run Text="määräaika " Foreground="{StaticResource Muted}" /><Run Text="{Binding DeadlineText, Mode=OneWay}" /><Run Text=" · " Foreground="{StaticResource Muted}" /><Run Text="{Binding AiTopic, Mode=OneWay}" />
                                        </TextBlock>
                                    </WrapPanel>
                                    <TextBlock Text="Yhteenveto" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" LineHeight="19" />
                                    <TextBlock Text="Perustelu" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Rationale}" TextWrapping="Wrap" LineHeight="19" />
                                    <TextBlock Text="{Binding Review}" Foreground="#8A5300" TextWrapping="Wrap" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding ModelInfo}" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="Paikallisen kielimallin ehdotus: tarkista lähettäjä ennen maksuja tai tunnusten antamista." />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
